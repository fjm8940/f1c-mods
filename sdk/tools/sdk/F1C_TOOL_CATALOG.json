{
  "schema": "f1c.tool_catalog.v1",
  "catalog_version": 1,
  "purpose": "Give LLMs one preferred tool for each job while preserving every implementation and its evidence.",
  "selection_rule": "Choose a preferred capability by job. Backends are reached through the front door; specialists are chosen only for their narrow job; superseded, paused, evidence-only, and locked-cabinet implementations are never default choices.",
  "roles": {
    "workbench": "Orients and coordinates a complete workflow.",
    "tool_chest": "Finds the right capability and explains why it is the right choice.",
    "magnifying_glass": "Finds and explains static evidence.",
    "measuring_tape": "Measures known state without changing it.",
    "multimeter": "Observes live process state without commanding behavior.",
    "camera": "Captures a visual or temporal record.",
    "level": "Validates, compares, or tests an artifact.",
    "saw": "Generates or builds a bounded artifact.",
    "jig": "Repeats a multi-step workflow deterministically.",
    "tool_cart": "Stages or packages an owned artifact.",
    "hammer": "Intentionally commands live state or user input.",
    "dremel": "Performs a narrow expert investigation with sharp edges.",
    "label_maker": "Builds indexes, schemas, or generated reference material.",
    "locked_cabinet": "Requires exceptional manual review because it can affect credentials, binaries, production state, or desktop control.",
    "museum_shelf": "Preserved history or a superseded implementation; evidence only."
  },
  "statuses": {
    "preferred": "The sole default choice for this job.",
    "specialist": "Supported only for the narrow job stated here.",
    "backend": "Implementation detail used through a preferred front-door command.",
    "superseded": "A better supported tool owns this job.",
    "evidence-only": "Preserved to explain or reproduce historical evidence, not for current execution.",
    "paused": "Belongs to a deliberately paused product direction.",
    "locked-cabinet": "Never run automatically; requires explicit owner review."
  },
  "effects": {
    "read-only": "Reads repository or process state and writes nothing.",
    "artifact-write": "Creates new evidence or build output and refuses unsafe overwrite where supported.",
    "config-write": "Edits a game or project configuration with restoration requirements.",
    "live-write": "Writes to the running game or injects input.",
    "process-control": "Attaches, launches, unloads, pauses, or otherwise controls a process.",
    "credential-write": "Changes authentication material.",
    "binary-write": "Patches, injects, or replaces executable code or binary state."
  },
  "discovery": {
    "roots": [
      ".",
      "tools",
      "mods"
    ],
    "extensions": [
      ".py",
      ".js",
      ".bat",
      ".cmd",
      ".ps1",
      ".exe"
    ],
    "exclude_globs": [
      ".git/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "tools/sdk/tests/**",
      "mods/**/build/**",
      "mods/**/generated/**"
    ]
  },
